# Environment variables for LOCAL development
# Copy this to .env and fill in your values

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/setly-dev?retryWrites=true&w=majority

# AWS Configuration (for local S3 testing)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here

# S3 Bucket
S3_BUCKET_NAME=setly-user-uploads-dev

# CloudFront Domain (will be set after first deployment)
CLOUDFRONT_DOMAIN=placeholder.cloudfront.net

# Environment
NODE_ENV=development
STAGE=local
PORT=3000

# API Keys (for Explore features - will move to AWS Secrets Manager)
GOOGLE_MAPS_API_KEY=your_google_maps_key
TICKETMASTER_API_KEY=your_ticketmaster_key
EVENTBRITE_API_KEY=your_eventbrite_key
