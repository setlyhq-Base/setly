{
  "name": "setly-backend-lambda",
  "version": "1.0.0",
  "description": "Setly Backend API for AWS Lambda",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "deploy": "npm run build && serverless deploy",
    "deploy:dev": "npm run build && serverless deploy --stage dev",
    "deploy:stage": "npm run build && serverless deploy --stage stage",
    "deploy:prod": "npm run build && serverless deploy --stage prod",
    "local": "serverless offline start",
    "test": "jest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.511.0",
    "@aws-sdk/client-secrets-manager": "^3.511.0",
    "@aws-sdk/s3-request-presigner": "^3.511.0",
    "aws-lambda": "^1.0.7",
    "axios": "^1.6.5",
    "express": "^4.18.2",
    "serverless-http": "^3.2.0",
    "node-cache": "^5.1.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "cors": "^2.8.5",
    "joi": "^17.11.0",
    "uuid": "^9.0.1",
    "mongoose": "^8.0.4",
    "mongodb": "^6.3.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.132",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.5",
    "@types/cors": "^2.8.17",
    "@types/uuid": "^9.0.7",
    "serverless": "^3.38.0",
    "serverless-offline": "^13.3.3",
    "serverless-plugin-typescript": "^2.1.5",
    "typescript": "^5.3.3",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.11"
  }
}
