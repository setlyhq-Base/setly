{
  "name": "setly-backend-lambda",
  "version": "1.0.0",
  "description": "Setly Backend API for AWS Lambda",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "ts-node src/server-local.ts",
    "dev": "nodemon --exec ts-node src/server-local.ts",
    "deploy": "npm run build && serverless deploy",
    "deploy:dev": "npm run build && serverless deploy --stage dev",
    "deploy:stage": "npm run build && serverless deploy --stage stage",
    "deploy:prod": "npm run build && serverless deploy --stage prod",
    "local": "serverless offline start",
    "test": "jest",
    "seed:fallback-rides": "npx tsx src/scripts/seed-fallback-rides.ts",
    "seed:dummy-users": "npx tsx src/scripts/seed-dummy-users.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.511.0",
    "@aws-sdk/client-secrets-manager": "^3.511.0",
    "@aws-sdk/s3-request-presigner": "^3.511.0",
    "aws-lambda": "^1.0.7",
    "axios": "^1.6.5",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^6.3.0",
    "mongoose": "^8.0.4",
    "node-cache": "^5.1.2",
    "serverless-http": "^3.2.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.132",
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/dotenv": "^6.1.1",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.11.5",
    "@types/uuid": "^9.0.7",
    "dotenv": "^17.2.3",
    "jest": "^29.7.0",
    "nodemon": "^3.1.11",
    "serverless": "^3.38.0",
    "serverless-offline": "^13.3.3",
    "serverless-plugin-typescript": "^2.1.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
