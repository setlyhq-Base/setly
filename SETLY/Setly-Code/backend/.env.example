# Backend environment example. Copy to .env and fill in values.

# --- AWS S3 (optional; enables uploads route) ---
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-bucket-name
AWS_ACCESS_KEY_ID=AKIA...FROM_CSV
AWS_SECRET_ACCESS_KEY=...FROM_CSV

# --- Firebase Admin (optional; enables server-side token verification) ---
# Option A: 3 separate env vars from your service account JSON
FIREBASE_PROJECT_ID=setly-fire
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@setly-fire.iam.gserviceaccount.com
# For multiline private key, escape newlines as \n on one line
FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n
# Option B: Point to the service account JSON file (ADC)
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# Option C: Paste the full JSON as a single env var (be careful with quotes)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...", ...}


# --- OpenAI (optional; enables real assistant responses) ---
OPENAI_API_KEY=sk-...your-key-here
OPENAI_MODEL=gpt-4o-mini